    repoUrl: 'https://github.com/Netflix/dispatch/tree/dd2837e82a0bf5565b1b4b4b91ea30b7262d4061',
    commit: 'dd2837e',
    stack: 'Python FastAPI (@router / Pydantic) · TypeScript / Vue',
    files: '664',
    nodes: '559',
    edges: '1,726',
    contracts: '43 linked contracts',
    statusBadge: '43 Linked · 8 External Webhooks',
    statusTone: 'success',
    tokenReduction: '93.4% (2-hop L3 slice)',
    summary:
      'Large-scale incident-management platform with 277 FastAPI producer endpoints and 43 linked TypeScript/Vue client contracts. Only 8 external plugin webhook calls (Opsgenie, Zoom, GitHub) remain unlinked locally.',
    findings: [
      {
        verb: 'GET / POST',
        route: '/api/v1/incidents & /api/v1/cases',
        consumer: 'incident/api.ts & case/api.ts',
        producer: 'incident/views.py & case/views.py',
