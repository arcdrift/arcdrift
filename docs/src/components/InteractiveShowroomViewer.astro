    arcMmd: `flowchart TB
    %% @arc:project name="dispatch" version="1.0"

    subgraph vue_ts["Vue / TypeScript API Clients (TS_CLIENT)"]
        IncidentApi["incident/api.ts<br/><i>«axios · IncidentRead»</i>"]
        CaseApi["case/api.ts<br/><i>«axios · CaseRead»</i>"]
