    subgraph fastapi_routers["FastAPI Routers (PYTHON_CONSUMER / PRODUCER)"]
        IncidentViews["incident/views.py<br/><i>«@router · /api/v1/incidents»</i>"]
        CaseViews["case/views.py<br/><i>«@router · /api/v1/cases»</i>"]
    end

    IncidentApi -->|"GET /api/v1/incidents"| IncidentViews
    CaseApi -->|"POST /api/v1/cases"| CaseViews
    PluginWebhook -.->|"External webhook"| CaseViews

    style IncidentViews fill:#18181b,stroke:#3b82f6,stroke-width:2px,color:#f4f4f5
    style IncidentApi fill:#062e22,stroke:#10b981,stroke-width:2px,color:#d1fae5`
  },
  {
    id: 'gotson-komga',
    name: 'Komga (Kotlin Spring Boot + Vue)',
    repoUrl: 'https://github.com/gotson/komga/tree/db2ad643c64d9199f7dd01cd3cca3ff0e7a17445',
    commit: 'db2ad64',
    stack: 'Kotlin Spring Boot · Vue 2 + Next UI (@hey-api/openapi-ts)',
    files: '973',
    nodes: '927',
    edges: '2,084',
    contracts: '42 linked contracts',
    statusBadge: '42 Linked Across Dual Frontends',
    statusTone: 'success',
    tokenReduction: '93.0% (2-hop L3 slice)',
    summary:
      'Production Kotlin Spring Boot media server serving both a legacy Vue 2 UI and a modern @hey-api/openapi-ts frontend. ArcDrift parses 248 Kotlin endpoints and 240 consumer calls across 973 files.',
    findings: [
      {
        verb: 'GET / PATCH',
        route: '/api/v1/series & /api/v1/books',
        consumer: 'komga-webui & @hey-api SDK',
        producer: 'SeriesController.kt & BookController.kt',
        detail: 'Linked 42 cross-language contracts across Kotlin Spring Boot and dual Vue/TypeScript frontends.'
      }
    ],
    arcMmd: `flowchart TB
    %% @arc:project name="komga" version="1.0"

    subgraph frontends["Dual TypeScript Frontends (TS_CLIENT)"]
        WebUiSeries["komga-series.service.ts<br/><i>«Vue 2 · PageSeriesDto»</i>"]
        OpenApiSdk["sdk.gen.ts<br/><i>«@hey-api/openapi-ts»</i>"]
    end

    subgraph kotlin_api["Kotlin Spring Boot Controllers (REST_CONTROLLER)"]
        SeriesController["SeriesController.kt<br/><i>«@RestController · /api/v1/series»</i>"]
        BookController["BookController.kt<br/><i>«@RestController · /api/v1/books»</i>"]
    end

    WebUiSeries -->|"GET /api/v1/series (SeriesDto)"| SeriesController
    OpenApiSdk -->|"GET /api/v1/books (BookDto)"| BookController

    style SeriesController fill:#18181b,stroke:#3b82f6,stroke-width:2px,color:#f4f4f5
    style OpenApiSdk fill:#062e22,stroke:#10b981,stroke-width:2px,color:#d1fae5`
  }
];
---

<div class="arc-showroom not-content" data-showroom>
  <!-- Structured 2-Column Repository Selector Grid -->
  <div class="arc-showroom-nav" role="tablist" aria-label="Open-source benchmark repositories">
    {showroomRepos.map((repo, idx) => (
      <button
        type="button"
        role="tab"
        id={`showroom-tab-${repo.id}`}
        aria-controls={`showroom-panel-${repo.id}`}
        aria-selected={idx === 0 ? 'true' : 'false'}
        tabindex={idx === 0 ? 0 : -1}
        class={`arc-showroom-pill ${idx === 0 ? 'is-active' : ''}`}
        data-showroom-tab={idx}
      >
        <span class="arc-showroom-pill-title">{repo.name}</span>
        <span class="arc-showroom-pill-meta">{repo.files} files · {repo.contracts}</span>
        <span class="arc-showroom-pill-stack">{repo.stack}</span>
      </button>
    ))}
  </div>

  {showroomRepos.map((repo, idx) => (
    <div
      id={`showroom-panel-${repo.id}`}
      role="tabpanel"
      aria-labelledby={`showroom-tab-${repo.id}`}
      class={`arc-showroom-panel ${idx === 0 ? 'is-active' : ''}`}
      data-showroom-panel={idx}
    >
      <!-- Telemetry Strip -->
      <div class="arc-showroom-metrics">
        <div class="arc-showroom-metric">
          <span class="arc-showroom-metric-k">Repository & Tested Commit</span>
          <a href={repo.repoUrl} target="_blank" rel="noopener noreferrer" class="arc-showroom-metric-v arc-showroom-link">
            {repo.stack} @ <code>{repo.commit}</code> ↗
          </a>
        </div>
        <div class="arc-showroom-metric">
          <span class="arc-showroom-metric-k">Graph Scale</span>
          <span class="arc-showroom-metric-v">{repo.files} files · {repo.nodes} nodes · {repo.edges} edges</span>
        </div>
        <div class="arc-showroom-metric">
          <span class="arc-showroom-metric-k">Cross-Language Contracts</span>
          <span class="arc-showroom-metric-v">{repo.contracts} · {repo.statusBadge}</span>
        </div>
        <div class="arc-showroom-metric">
          <span class="arc-showroom-metric-k">2-Hop MCP Slice Reduction</span>
          <span class="arc-showroom-metric-v">{repo.tokenReduction}</span>
        </div>
      </div>

      <p class="arc-showroom-summary">{repo.summary}</p>

      <!-- Interactive Mermaid Canvas & Raw .arc.mmd Switcher -->
      <div class="arc-showroom-canvas-shell" data-canvas-shell>
        <div class="arc-showroom-toolbar">
          <div class="arc-showroom-toolbar-left">
            <span class="arc-showroom-file-chip">architecture.arc.mmd</span>
            <button type="button" class="arc-showroom-btn is-active" data-view-mode="diagram">
              Diagram
            </button>
            <button type="button" class="arc-showroom-btn" data-view-mode="code">
              .arc.mmd Source
            </button>
          </div>
          <div class="arc-showroom-toolbar-right">
            <button type="button" class="arc-showroom-btn" data-zoom-out title="Zoom Out">−</button>
            <span class="arc-showroom-zoom-label" data-zoom-label>100%</span>
            <button type="button" class="arc-showroom-btn" data-zoom-in title="Zoom In">+</button>
            <button type="button" class="arc-showroom-btn" data-zoom-reset>Reset</button>
            <button type="button" class="arc-showroom-btn arc-showroom-btn--primary" data-copy-mmd>
              Copy .arc.mmd
            </button>
          </div>
        </div>

        <div
          class="arc-showroom-diagram-viewport"
          data-diagram-viewport
          tabindex="0"
          role="region"
          aria-label={`Interactive C4 architecture diagram for ${repo.name}`}
        >
          <div class="arc-showroom-diagram-inner" data-diagram-inner>
            <pre class="arc-mermaid-source" data-mermaid-source>{repo.arcMmd}</pre>
            <div class="arc-mermaid-target" data-mermaid-target>Rendering interactive C4 graph...</div>
          </div>
        </div>

        <pre class="arc-showroom-code-view" data-code-view hidden><code>{repo.arcMmd}</code></pre>
      </div>

      <!-- Verified Contract Findings & 1-Click False-Positive Feedback -->
      <div class="arc-showroom-findings">
        <div class="arc-showroom-findings-header">
          <span>Verified Cross-Language Contract Findings</span>
          <a
            href={`https://github.com/arcdrift/arcdrift/issues/new?labels=feedback,showroom&title=${encodeURIComponent(`[Showroom Feedback] ${repo.name}`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="arc-showroom-feedback-btn"
          >
            Report False Positive / Suggest Repo ↗
          </a>
        </div>
        <div class="arc-showroom-findings-grid">
          {repo.findings.map((f) => (
            <div class="arc-showroom-finding-card">
              <div class="arc-showroom-finding-top">
                <span class="arc-showroom-verb">{f.verb}</span>
                <code class="arc-showroom-route">{f.route}</code>
              </div>
              <div class="arc-showroom-finding-endpoints">
                <span><strong>Consumer:</strong> {f.consumer}</span>
                <span><strong>Producer:</strong> {f.producer}</span>
              </div>
              <p class="arc-showroom-finding-detail">{f.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  ))}
</div>

<script>
  import mermaid from 'mermaid';

  mermaid.initialize({
    startOnLoad: false,
    theme: 'base',
    securityLevel: 'loose',
    themeVariables: {
      darkMode: true,
      background: '#09090b',
      primaryColor: '#18181b',
      primaryTextColor: '#f4f4f5',
      primaryBorderColor: '#3f3f46',
      lineColor: '#71717a',
      secondaryColor: '#121215',
      tertiaryColor: '#141418',
      clusterBkg: '#121215',
      clusterBorder: '#27272a',
      edgeLabelBackground: '#18181b',
      fontFamily: 'Inter, system-ui, sans-serif'
    },
    flowchart: {
      htmlLabels: true,
      curve: 'basis',
      padding: 16
    }
  });

  async function renderVisibleDiagrams(root: Element) {
    const activePanel = root.querySelector('.arc-showroom-panel.is-active');
    if (!activePanel) return;
    const target = activePanel.querySelector('[data-mermaid-target]');
    const source = activePanel.querySelector('[data-mermaid-source]');
    if (!target || !source || target.getAttribute('data-rendered') === 'true') return;

    const rawMmd = source.textContent || '';
    try {
      const id = 'arc-mmd-' + Math.random().toString(36).slice(2, 9);
      const { svg } = await mermaid.render(id, rawMmd);
      target.innerHTML = svg;
      const svgEl = target.querySelector('svg');
      if (svgEl) {
        svgEl.style.maxWidth = '100%';
        svgEl.style.height = 'auto';
      }
      target.setAttribute('data-rendered', 'true');
    } catch (err) {
      target.textContent = 'Failed to render Mermaid diagram; inspect .arc.mmd Source tab.';
    }
  }

  function initShowrooms() {
    document.querySelectorAll('[data-showroom]').forEach((root) => {
      if ((root as HTMLElement).dataset.showroomBound === 'true') return;
      (root as HTMLElement).dataset.showroomBound = 'true';

      const tabs = Array.from(root.querySelectorAll('[data-showroom-tab]')) as HTMLButtonElement[];
      const panels = root.querySelectorAll('[data-showroom-panel]');

      function activateTab(idx: number, moveFocus = false) {
        tabs.forEach((t, i) => {
          const active = i === idx;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', active ? 'true' : 'false');
          t.setAttribute('tabindex', active ? '0' : '-1');
        });
        panels.forEach((p, i) => {
          p.classList.toggle('is-active', i === idx);
        });
        if (moveFocus && tabs[idx]) tabs[idx].focus();
        renderVisibleDiagrams(root);
      }

      tabs.forEach((tab, idx) => {
        tab.addEventListener('click', () => activateTab(idx));
        tab.addEventListener('keydown', (e: KeyboardEvent) => {
          if (e.key === 'ArrowRight') {
            e.preventDefault();
            activateTab((idx + 1) % tabs.length, true);
          } else if (e.key === 'ArrowLeft') {
            e.preventDefault();
            activateTab((idx - 1 + tabs.length) % tabs.length, true);
          } else if (e.key === 'Home') {
            e.preventDefault();
            activateTab(0, true);
          } else if (e.key === 'End') {
            e.preventDefault();
            activateTab(tabs.length - 1, true);
          }
        });
      });

      root.querySelectorAll('[data-canvas-shell]').forEach((shell) => {
        let scale = 1;
        const inner = shell.querySelector('[data-diagram-inner]') as HTMLElement | null;
        const zoomLabel = shell.querySelector('[data-zoom-label]');
        const diagramViewport = shell.querySelector('[data-diagram-viewport]') as HTMLElement | null;
        const codeView = shell.querySelector('[data-code-view]');
        const modeBtns = shell.querySelectorAll('[data-view-mode]');
        const sourceEl = shell.querySelector('[data-mermaid-source]');
        const copyBtn = shell.querySelector('[data-copy-mmd]');

        function applyZoom() {
          if (inner) inner.style.transform = `scale(${scale})`;
          if (zoomLabel) zoomLabel.textContent = `${Math.round(scale * 100)}%`;
        }

        shell.querySelector('[data-zoom-in]')?.addEventListener('click', () => {
          scale = Math.min(2.0, +(scale + 0.15).toFixed(2));
          applyZoom();
        });
        shell.querySelector('[data-zoom-out]')?.addEventListener('click', () => {
          scale = Math.max(0.55, +(scale - 0.15).toFixed(2));
          applyZoom();
        });
        shell.querySelector('[data-zoom-reset]')?.addEventListener('click', () => {
          scale = 1;
          applyZoom();
        });

        // Click-and-drag panning inside the diagram viewport
        if (diagramViewport) {
          let isPanning = false;
          let startX = 0;
          let startY = 0;
          let scrollLeft = 0;
          let scrollTop = 0;

          diagramViewport.addEventListener('mousedown', (e) => {
            if (e.button !== 0) return;
            isPanning = true;
            diagramViewport.classList.add('is-panning');
            startX = e.pageX - diagramViewport.offsetLeft;
            startY = e.pageY - diagramViewport.offsetTop;
            scrollLeft = diagramViewport.scrollLeft;
            scrollTop = diagramViewport.scrollTop;
          });
          window.addEventListener('mouseup', () => {
            if (!isPanning) return;
            isPanning = false;
            diagramViewport.classList.remove('is-panning');
          });
          diagramViewport.addEventListener('mousemove', (e) => {
            if (!isPanning) return;
            e.preventDefault();
            const x = e.pageX - diagramViewport.offsetLeft;
            const y = e.pageY - diagramViewport.offsetTop;
            diagramViewport.scrollLeft = scrollLeft - (x - startX);
            diagramViewport.scrollTop = scrollTop - (y - startY);
          });
        }

        modeBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const mode = btn.getAttribute('data-view-mode');
            modeBtns.forEach((b) => b.classList.toggle('is-active', b === btn));
            if (mode === 'code') {
              diagramViewport?.setAttribute('hidden', '');
              codeView?.removeAttribute('hidden');
            } else {
              codeView?.setAttribute('hidden', '');
              diagramViewport?.removeAttribute('hidden');
              renderVisibleDiagrams(root);
            }
          });
        });

        copyBtn?.addEventListener('click', async () => {
          const text = sourceEl?.textContent || '';
          await navigator.clipboard.writeText(text);
          const orig = copyBtn.textContent;
          copyBtn.textContent = 'Copied!';
          setTimeout(() => {
            copyBtn.textContent = orig;
          }, 1500);
        });
      });

      renderVisibleDiagrams(root);
    });
  }

  initShowrooms();
  document.addEventListener('astro:page-load', initShowrooms);
</script>

<style>
  .arc-showroom {
    margin: 1.5rem 0 2.5rem;
    border-radius: 8px;
    background: var(--arc-bg-panel);
    border: 1px solid var(--arc-border-subtle);
    padding: 1.15rem;
    box-shadow: var(--arc-shadow);
  }

  .arc-showroom-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.45rem;
    padding-bottom: 0.95rem;
    border-bottom: 1px solid var(--arc-border-subtle);
  }

  .arc-showroom-pill {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.22rem;
    text-align: left;
    padding: 0.55rem 0.75rem;
    border-radius: 7px;
    border: 1px solid var(--arc-border-strong);
    background: var(--arc-bg-elevated);
    color: var(--arc-text-secondary);
    font-family: var(--sl-font);
    cursor: pointer;
    min-width: 0;
    transition: background 120ms ease, border-color 120ms ease, color 120ms ease;
  }

  .arc-showroom-pill-title {
    display: block;
    width: 100%;
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.3;
    color: inherit;
  }

  .arc-showroom-pill-meta {
    display: block;
    width: 100%;
    font-family: var(--sl-font-mono);
    font-size: 0.69rem;
    line-height: 1.35;
    color: var(--arc-text-muted);
  }

  .arc-showroom-pill-stack {
    display: block;
    width: 100%;
    font-size: 0.72rem;
    line-height: 1.38;
    color: var(--arc-text-muted);
  }

  .arc-showroom-pill:hover {
    background: var(--arc-bg-hover);
    border-color: var(--arc-border-hover);
    color: var(--arc-text-strong);
  }

  .arc-showroom-pill.is-active {
    background: #1d4ed8;
    border-color: #3b82f6;
    color: #ffffff;
  }

  .arc-showroom-pill.is-active .arc-showroom-pill-meta,
  .arc-showroom-pill.is-active .arc-showroom-pill-stack {
    color: #dbeafe;
  }

  .arc-showroom-panel {
    display: none;
    padding-top: 1rem;
  }

  .arc-showroom-panel.is-active {
    display: block;
  }

  .arc-showroom-metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
    margin-bottom: 0.9rem;
  }

  @media (max-width: 640px) {
    .arc-showroom-nav,
    .arc-showroom-metrics {
      grid-template-columns: 1fr;
    }
  }

  .arc-showroom-metric {
    padding: 0.65rem 0.85rem;
    border-radius: 6px;
    background: var(--arc-bg-elevated);
    border: 1px solid var(--arc-border-subtle);
  }

  .arc-showroom-metric-k {
    display: block;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--arc-text-muted);
  }

  .arc-showroom-metric-v {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--arc-text-strong);
  }

  .arc-showroom-link {
    color: var(--arc-link);
    text-decoration: none;
  }

  .arc-showroom-link:hover {
    text-decoration: underline;
  }

  .arc-showroom-summary {
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--arc-text-secondary);
    margin: 0 0 1rem;
  }

  .arc-showroom-canvas-shell {
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--arc-border-subtle);
    background: #09090b;
  }

  .arc-showroom-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.55rem 0.85rem;
    background: var(--arc-bg-header);
    border-bottom: 1px solid var(--arc-border-subtle);
  }

  .arc-showroom-toolbar-left,
  .arc-showroom-toolbar-right {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .arc-showroom-file-chip {
    font-family: var(--sl-font-mono);
    font-size: 0.74rem;
    padding: 0.18rem 0.55rem;
    border-radius: 4px;
    background: var(--arc-bg-elevated);
    border: 1px solid var(--arc-border-strong);
    color: var(--arc-text-primary);
  }

  .arc-showroom-btn {
    padding: 0.28rem 0.65rem;
    border-radius: 5px;
    border: 1px solid var(--arc-border-strong);
    background: var(--arc-bg-elevated);
    color: var(--arc-text-primary);
    font-family: var(--sl-font);
    font-size: 0.74rem;
    font-weight: 600;
    cursor: pointer;
  }

  .arc-showroom-btn:hover {
    background: var(--arc-bg-hover);
    border-color: var(--arc-border-hover);
    color: var(--arc-text-strong);
  }

  .arc-showroom-btn.is-active,
  .arc-showroom-btn--primary {
    background: #2563eb;
    border-color: #3b82f6;
    color: #ffffff;
  }

  .arc-showroom-zoom-label {
    font-family: var(--sl-font-mono);
    font-size: 0.74rem;
    color: var(--arc-text-muted);
    min-width: 3rem;
    text-align: center;
  }

  .arc-showroom-diagram-viewport {
    overflow: auto;
    min-height: 360px;
    max-height: 540px;
    padding: 1.25rem;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    background: #09090b;
    cursor: grab;
  }

  .arc-showroom-diagram-viewport.is-panning {
    cursor: grabbing;
    user-select: none;
  }

  .arc-showroom-diagram-viewport[hidden],
  .arc-showroom-code-view[hidden] {
    display: none !important;
  }

  .arc-showroom-diagram-inner {
    transform-origin: top center;
    transition: transform 0.18s ease;
    width: 100%;
    text-align: center;
  }

  .arc-mermaid-source {
    display: none;
  }

  .arc-showroom-code-view {
    margin: 0;
    padding: 1rem;
    max-height: 460px;
    overflow: auto;
    font-family: var(--sl-font-mono);
    font-size: 0.78rem;
    background: #09090b;
    color: #e4e4e7;
  }

  .arc-showroom-findings {
    margin-top: 1rem;
  }

  .arc-showroom-findings-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.6rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--arc-text-strong);
  }

  .arc-showroom-feedback-btn {
    font-size: 0.75rem;
    color: var(--arc-text-primary);
    text-decoration: none;
    padding: 0.25rem 0.65rem;
    border-radius: 5px;
    border: 1px solid var(--arc-border-strong);
    background: var(--arc-bg-elevated);
  }

  .arc-showroom-feedback-btn:hover {
    background: var(--arc-bg-hover);
    border-color: var(--arc-border-hover);
    color: var(--arc-text-strong);
  }

  .arc-showroom-findings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
