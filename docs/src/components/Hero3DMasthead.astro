---
interface Props {
  initialSlide?: number;
}
const { initialSlide = 0 } = Astro.props;

const slides = [
  {
    id: 'canvas-agent',
    label: '1. Live C4 Canvas & Agent',
    badge: 'IntelliJ IDEA Tool Window',
    src: '/screenshots/agent-self-healed-canvas.jpg',
    alt: 'ArcDrift C4 L3 Component Canvas and Self-Healing Agent Workspace in IntelliJ IDEA',
    caption: 'Live C4 L3 component graph with cross-language REST/Kafka contract edges and docked Self-Healing Agent.'
  },
  {
    id: 'contract-violation',
    label: '2. Cross-Language Contract Drift',
    badge: 'Polyglot Contract Guardrail',
    src: '/screenshots/contract-mismatch-violation.jpg',
    alt: 'ArcDrift flagging a TypeScript to Spring Boot REST contract mismatch',
    caption: 'Real-time detection of route typos, missing endpoints, and @RequestBody / response DTO field drift across Kotlin, Java, Python, and TypeScript.'
  },
  {
    id: 'pr-blast-radius',
    label: '3. CI/CD Blast-Radius Diff',
    badge: 'GitHub / GitLab / SonarQube / SARIF',
    src: '/screenshots/ci-pr-blast-radius.svg',
    alt: 'Automated Pull Request Blast-Radius and Mermaid Diff Report',
    caption: 'Automated pull-request blast-radius report with collapsible Mermaid diff and native SARIF 2.1.0 / SonarQube Generic Issue export.'
  }
];
---

<section class="arc-hero3d-root not-content" data-hero3d>
  <!-- Top View Switcher & Caption Bar -->
  <div class="arc-hero3d-header">
    <div class="arc-hero3d-tabs" role="tablist" aria-label="Masthead preview modes">
      {slides.map((slide, idx) => (
        <button
          type="button"
          role="tab"
          id={`hero3d-tab-${slide.id}`}
          aria-controls="hero3d-tabpanel"
          aria-selected={idx === initialSlide ? 'true' : 'false'}
          tabindex={idx === initialSlide ? 0 : -1}
          class={`arc-hero3d-tab ${idx === initialSlide ? 'is-active' : ''}`}
          data-hero3d-btn={idx}
          data-badge={slide.badge}
          data-caption={slide.caption}
        >
          {slide.label}
        </button>
      ))}
    </div>
    <p class="arc-hero3d-caption" data-hero3d-caption>{slides[initialSlide].caption}</p>
  </div>

  <!-- 3D Isometric Engineering Viewport -->
  <div class="arc-hero3d-stage-wrap">
    <div class="arc-hero3d-stage" data-hero3d-stage>
      <!-- Solid Architectural Shadow Plate (Zero Blur / Zero Gradient) -->
      <div class="arc-hero3d-backplate" aria-hidden="true"></div>

      <!-- Main IDE Window Surface -->
      <div class="arc-hero3d-window">
        <div class="arc-hero3d-titlebar">
          <div class="arc-hero3d-window-title">
            ArcDrift — C4 Architecture Control Plane & Polyglot Contract Bridge
          </div>
          <div class="arc-hero3d-window-badge" data-hero3d-badge>{slides[initialSlide].badge}</div>
        </div>

        <div
          class="arc-hero3d-viewport"
          id="hero3d-tabpanel"
          role="tabpanel"
          aria-labelledby={`hero3d-tab-${slides[initialSlide].id}`}
        >
          {slides.map((slide, idx) => (
            <img
              src={slide.src}
              alt={slide.alt}
              class={`arc-hero3d-img ${idx === initialSlide ? 'is-active' : ''}`}
              data-hero3d-img={idx}
              loading={idx === 0 ? 'eager' : 'lazy'}
            />
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Clean 4-Column Engineering Telemetry Footer -->
  <div class="arc-hero3d-telemetry">
    <div class="arc-hero3d-stat">
      <span class="arc-hero3d-stat-val">449 Linked Contracts</span>
      <span class="arc-hero3d-stat-sub">Verified across 10 OSS repos (7,637 files)</span>
    </div>
    <div class="arc-hero3d-stat">
      <span class="arc-hero3d-stat-val">8 / 8 Mutation Recall</span>
      <span class="arc-hero3d-stat-sub">Route, Response DTO & @RequestBody drift</span>
    </div>
    <div class="arc-hero3d-stat">
      <span class="arc-hero3d-stat-val">89.1% Token Reduction</span>
      <span class="arc-hero3d-stat-sub">2-Hop C4 L3 MCP slice vs. raw source</span>
    </div>
    <div class="arc-hero3d-stat">
      <span class="arc-hero3d-stat-val">SARIF 2.1 & SonarQube</span>
      <span class="arc-hero3d-stat-sub">1-command CI & multi-repo federation</span>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('[data-hero3d]').forEach((root) => {
    const stage = root.querySelector('[data-hero3d-stage]') as HTMLElement | null;
    const buttons = Array.from(root.querySelectorAll('[data-hero3d-btn]')) as HTMLButtonElement[];
    const images = root.querySelectorAll('[data-hero3d-img]');
    const badgeEl = root.querySelector('[data-hero3d-badge]');
    const captionEl = root.querySelector('[data-hero3d-caption]');
    const panelEl = root.querySelector('#hero3d-tabpanel');

    function activateSlide(targetIdx: number, moveFocus = false) {
      buttons.forEach((b, i) => {
        const active = i === targetIdx;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-selected', active ? 'true' : 'false');
        b.setAttribute('tabindex', active ? '0' : '-1');
      });
      images.forEach((img, i) => {
        img.classList.toggle('is-active', i === targetIdx);
      });
      const activeBtn = buttons[targetIdx];
      if (activeBtn) {
        if (badgeEl) badgeEl.textContent = activeBtn.getAttribute('data-badge') || '';
        if (captionEl) captionEl.textContent = activeBtn.getAttribute('data-caption') || '';
        if (panelEl) panelEl.setAttribute('aria-labelledby', activeBtn.id);
        if (moveFocus) activeBtn.focus();
      }
    }

    buttons.forEach((btn, idx) => {
      btn.addEventListener('click', () => activateSlide(idx));
      btn.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          activateSlide((idx + 1) % buttons.length, true);
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          activateSlide((idx - 1 + buttons.length) % buttons.length, true);
        } else if (e.key === 'Home') {
          e.preventDefault();
          activateSlide(0, true);
        } else if (e.key === 'End') {
          e.preventDefault();
          activateSlide(buttons.length - 1, true);
        }
      });
    });

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (stage && !reduceMotion && window.matchMedia('(pointer: fine)').matches) {
      stage.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = stage.getBoundingClientRect();
        const nx = (e.clientX - rect.left) / rect.width - 0.5;
        const ny = (e.clientY - rect.top) / rect.height - 0.5;
        const rotX = (5 - ny * 5).toFixed(2);
        const rotY = (-6 + nx * 8).toFixed(2);
        stage.style.transform = `rotateX(${rotX}deg) rotateY(${rotY}deg)`;
      });
      stage.addEventListener('mouseleave', () => {
        stage.style.transform = '';
      });
    }
  });
</script>

<style>
  .arc-hero3d-root {
    margin: 1.75rem 0 2.75rem;
    border-radius: 8px;
    background-color: var(--arc-bg-canvas);
    background-image:
      linear-gradient(to right, var(--arc-bg-grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--arc-bg-grid-line) 1px, transparent 1px);
    background-size: 24px 24px;
    border: 1px solid var(--arc-border-subtle);
    overflow: hidden;
    box-shadow: var(--arc-shadow);
  }

  .arc-hero3d-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem 1.15rem;
    background: var(--arc-bg-header);
    border-bottom: 1px solid var(--arc-border-subtle);
  }

  .arc-hero3d-tabs {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .arc-hero3d-tab {
    padding: 0.35rem 0.75rem;
    border-radius: 5px;
    border: 1px solid var(--arc-border-strong);
    background: var(--arc-bg-elevated);
    color: var(--arc-text-secondary);
    font-family: var(--sl-font);
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 120ms ease, border-color 120ms ease, color 120ms ease;
  }

  .arc-hero3d-tab:hover {
    background: var(--arc-bg-hover);
    border-color: var(--arc-border-hover);
    color: var(--arc-text-strong);
  }

  .arc-hero3d-tab.is-active {
    background: #2563eb;
    border-color: #3b82f6;
    color: #ffffff;
  }

  .arc-hero3d-caption {
    margin: 0;
    font-size: 0.8rem;
    color: var(--arc-text-muted);
  }

  .arc-hero3d-stage-wrap {
    perspective: 1600px;
    padding: 1.75rem 2.25rem 2.25rem;
  }

  .arc-hero3d-stage {
    position: relative;
    transform-style: preserve-3d;
    transform: rotateX(5.5deg) rotateY(-6.5deg);
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
    max-width: 1020px;
    margin: 0 auto;
  }

  .arc-hero3d-stage:hover {
    transform: rotateX(2deg) rotateY(-2deg);
  }

  .arc-hero3d-backplate {
    position: absolute;
    inset: 10px -10px -12px 10px;
    border-radius: 8px;
    background: var(--arc-bg-header);
    transform: translateZ(-20px);
    border: 1px solid var(--arc-border-strong);
    box-shadow: -16px 24px 48px rgba(0, 0, 0, 0.35);
  }

  .arc-hero3d-window {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    background: #09090b;
    border: 1px solid #3f3f46;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
    transform: translateZ(0);
  }

  .arc-hero3d-titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.55rem 0.95rem;
    background: #141418;
    border-bottom: 1px solid #27272a;
    font-size: 0.78rem;
    color: #d4d4d8;
  }

  .arc-hero3d-window-title {
    font-weight: 600;
    color: #f4f4f5;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .arc-hero3d-window-badge {
    font-family: var(--sl-font-mono);
    padding: 2px 8px;
    border-radius: 4px;
    background: #18181b;
    border: 1px solid #3f3f46;
    color: #d4d4d8;
    font-size: 0.72rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .arc-hero3d-viewport {
    position: relative;
    background: #09090b;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .arc-hero3d-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
  }

  .arc-hero3d-img.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .arc-hero3d-telemetry {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    background: var(--arc-bg-panel);
    border-top: 1px solid var(--arc-border-subtle);
  }

  .arc-hero3d-stat {
    padding: 0.75rem 1.1rem;
    border-right: 1px solid var(--arc-border-subtle);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .arc-hero3d-stat:last-child {
    border-right: none;
  }

  .arc-hero3d-stat-val {
    font-family: var(--sl-font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--arc-text-strong);
  }

  .arc-hero3d-stat-sub {
    font-size: 0.74rem;
    color: var(--arc-text-muted);
  }

  @media (max-width: 860px) {
    .arc-hero3d-stage-wrap {
      padding: 0.75rem;
    }
    .arc-hero3d-stage {
      transform: none !important;
    }
    .arc-hero3d-backplate {
      display: none;
    }
    .arc-hero3d-stat {
      border-right: none;
      border-bottom: 1px solid var(--arc-border-subtle);
    }
  }
</style>
